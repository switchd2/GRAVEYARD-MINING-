# ==============================================================================
# Graveyard Mining — Docker Compose Environment Variables
# ==============================================================================

# ── Database (PostgreSQL container) ───────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=graveyard_mining

# ── Database Connection URL ───────────────────────────────────────────────────
# Default in Docker Compose: postgresql://postgres:postgres@db:5432/graveyard_mining
# To use external DB (Railway / Supabase), override DATABASE_URL below:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── pgAdmin Configuration ─────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ── AI Services (OpenAI) ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub REST API ───────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Web Search & Integrations (Optional) ──────────────────────────────────────
TAVILY_API_KEY=tvly-dev-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_DSN=

# ── CORS & URLs ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
