# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (Transaction Pooler or Session Pooler URI)
# Local development default: sqlite:///./graveyard_mining.db
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── AI Services (OpenAI) ──────────────────────────────────────────────────────
# Required for failure diagnosis, text embeddings, and roadmap generation
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub REST API ───────────────────────────────────────────────────────────
# Personal Access Token — increases rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Web Context Search (Tavily) ───────────────────────────────────────────────
# Optional — queries web post-mortems for abandoned repos
TAVILY_API_KEY=tvly-dev-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Security & Maintenance Audit ──────────────────────────────────────────────
# Optional API keys for extended package security audits
LIBRARIES_IO_API_KEY=
SNYK_API_KEY=
SOCKET_API_KEY=

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://graveyard-mining.vercel.app

# ── Error Monitoring (Sentry) ─────────────────────────────────────────────────
# Optional Sentry DSN for production exception tracking
SENTRY_DSN=
